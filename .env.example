# ChatParser local configuration
# Copy values into your shell or macOS app settings; do not commit real secrets.

VOICEBOX_BASE_URL=http://127.0.0.1:17493
VOICEBOX_TRANSCRIPTION_MODEL=turbo
VOICEBOX_LANGUAGE=en

# Required only for text-to-audio voice cloning.
# Use a profile id returned by: curl http://127.0.0.1:17493/profiles
VOICEBOX_PROFILE_ID=
